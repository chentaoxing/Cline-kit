   "out": "$2年8月$1日"
  },
  {
   "pattern": "^Sep (\\d{1,2}), (\\d{4})$",
   "out": "$2年9月$1日"
  },
  {
   "pattern": "^Oct (\\d{1,2}), (\\d{4})$",
   "out": "$2年10月$1日"
  },
  {
   "pattern": "^Nov (\\d{1,2}), (\\d{4})$",
   "out": "$2年11月$1日"
  },
  {
   "pattern": "^Dec (\\d{1,2}), (\\d{4})$",
   "out": "$2年12月$1日"
  },
